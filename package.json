{
  "name": "cris-parambu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Gestão Cris Parambu - Vendas, Produtos, Fiados, Financeiro e Aluguéis",
  "scripts": {
    "dev": "tsx watch server/index.ts",
